<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<!-- fi: appi on suomenkielinen — App Storen "Kielet"-rivi päätellään tästä ja
	     lokalisoinneista (oli "en" → kauppa näytti EN). EN-lokalisointi lisätään
	     KIELIVERSIO.md:n vaiheessa 2, jolloin riviin tulee FI ja EN. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>fi</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fi</string>
		<string>en</string>
	</array>
	<!-- Kotinäytön nimi lyhyenä — "Varallisuuspolku" katkeaa ikonin alla (~11 merkkiä).
	     Kaupan nimi pysyy täytenä App Store Connectissa. -->
	<key>CFBundleDisplayName</key>
        <string>Polku</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- Tumma sovelluspinta: tilapalkin tekstit vaaleina -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<!-- Ei omaa salausta — TestFlight ei kysele vientisäädöksistä joka buildilla -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Sovelluksen lukitus (opt-in): Face ID avaa lukituksen -->
	<key>NSFaceIDUsageDescription</key>
	<string>Kasvojentunnistusta käytetään vain sovelluksen lukituksen avaamiseen.</string>
	<!-- Kuvakkeen pikatoiminnot (pitkä painallus): AppDelegate kirjaa tyypin
	     VpWidgetPluginiin ja web avaa oikean sivun -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>tulkki</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Kysy AI</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>sparkles</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>toteuma</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Toteuma</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>chart.line.uptrend.xyaxis</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>suunnitelma</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Suunnitelma</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>doc.text</string>
		</dict>
	</array>
</dict>
</plist>
