<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group: appi kirjoittaa widgetin tiivistelmän, widget lukee sen.
	     HUOM: ryhmä pitää rekisteröidä Applen porttaalissa ja liittää sekä
	     appin että widgetin bundle ID:hen ennen TestFlight-buildia. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.varallisuuspolku.app</string>
	</array>
</dict>
</plist>
